# Copy this file to .env and fill in what you need. Git ignores .env.
#
# Every value here is read at RUNTIME, when the server process starts. None of
# them are baked into the build or the Docker image, so changing one means
# restarting the process, never rebuilding.
#
# Locally, `make serve` needs nothing in this file: it provisions a PostgreSQL
# database and signs you in as local_dev by itself. Fill in DEXCOM_SECRET_KEY
# only if you want to connect Dexcom Share locally.
#
# A deployment needs APP_URL, DATABASE_URL, AUTH_SECRET, one OAuth provider
# pair, and at least one allowlist entry in CARBY_ALLOWED_USERS or
# CARBY_ALLOWED_EMAILS. Set those through the host's own configuration
# and mark every secret as a secret there.

# Canonical public origin of the deployment. Production requires a bare HTTPS
# origin: no username or password, no path beyond "/", no query, no fragment.
# OAuth callback URLs are built from it, so it must match what each provider
# has registered. The server refuses to start without it.
APP_URL=

# PostgreSQL connection string (postgres:// or postgresql://). Every replica and
# the release/migration process share one database. Treat it as a secret; it
# carries credentials.
#
# Leave this BLANK locally and `make serve` starts its own sandboxed PostgreSQL
# via Docker Compose (project carby-local, 127.0.0.1:55432) and migrates it.
# Set it yourself and Carby uses it as given and NEVER migrates it
# automatically -- run `make migrate` explicitly when you mean to.
DATABASE_URL=

# Session signing secret for @auth/core. Separate from DEXCOM_SECRET_KEY: these
# are two independent secrets and must not be the same value.
# Production requires at least 43 base64url characters (A-Z a-z 0-9 - _), which
# is 32 random bytes encoded; 64 hex characters also qualifies. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Leave blank here and set it during deployment. Rotating it signs everyone out
# and leaves stored records untouched.
AUTH_SECRET=

# OAuth credentials, both halves per provider you enable; leave the rest blank.
# Register each callback URL with its provider, using the host from APP_URL:
#   https://YOUR-CARBY-HOST/api/auth/callback/github
#   https://YOUR-CARBY-HOST/api/auth/callback/google
#   https://YOUR-CARBY-HOST/api/auth/callback/discord
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Allowlists. Sign-in denies by default and both lists are rechecked on every
# session read, so removing an entry revokes that person's current sessions.
#
# CARBY_ALLOWED_USERS takes comma-separated provider:subject pairs, e.g.
# github:12345 -- the account's stable id at that provider, which Carby also
# uses as the record owner. Carby links no accounts across providers.
CARBY_ALLOWED_USERS=
# CARBY_ALLOWED_EMAILS takes comma-separated addresses, matched only against an
# email the provider itself reports as verified. Unverified addresses never match.
# EITHER list admits on its own: a matching provider:subject entry admits, and so
# does a verified email on the email list, so you may fill one and leave the other
# blank. Leaving BOTH blank denies everyone.
CARBY_ALLOWED_EMAILS=

# Encryption key for the stored Dexcom Share sign-in and Clarity share code. It
# encrypts those credentials only, not your other health records. Carby's own key, not an API
# key Dexcom issues. Exactly 64 hex characters, which is 32 random bytes:
#   openssl rand -hex 32
# Optional: Dexcom stays unconfigured without it, but a value of any other shape
# stops the production server from starting rather than silently disabling sync.
# Keep the value stable: change it and existing Dexcom links stop decrypting and
# every account must reconnect.
DEXCOM_SECRET_KEY=

# Server-side Dexcom Share defaults. Nothing here connects an account on its
# own -- a signed-in user still opens Care tools > Dexcom · import > Live Share
# and chooses "Connect and pull readings".
#
# DEXCOM_USERNAME seeds the username field in the connect form; the user can edit it.
DEXCOM_USERNAME=
# DEXCOM_PASSWORD stays server-side and never reaches the browser. Carby uses it
# only when the connect request asks for it and the submitted username and region
# still match the configured pair. A password the user types wins and is saved in
# that account's Dexcom Share connection, so the override outlives the session.
DEXCOM_PASSWORD=
# Share region: us, ous, or jp. Defaults to us. Seeds the region field in the UI.
DEXCOM_REGION=
# Account that owns the defaults above, as an exact provider:subject pair, e.g.
# github:12345, so only that account ever uses them. Leave it unset and the
# defaults apply only to owner local_dev in a process a local launcher started
# (CARBY_AUTH_MODE=local plus CARBY_LOCAL_LAUNCHER=1) -- both `make serve` and
# `make start` qualify, and the production server refuses to boot when either
# holds a matching non-empty value.
# One set of deployment credentials never suits every allowlisted user, so name
# the single account that owns them.
DEXCOM_DEFAULT_OWNER=

# --- Optional runtime knobs ------------------------------------------------
# Loopback port the production app listens on. Default 3000. Must be 1-65535.
# scripts/start-web forwards the Cabotage socket to 127.0.0.1 on this port.
PORT=
# Unix socket scripts/start-web creates and forwards from.
# Default /var/run/cabotage/cabotage.sock, the path Cabotage expects.
CABOTAGE_SOCKET=
# Interface the app binds. Default 127.0.0.1. scripts/start-web always sets it to
# 127.0.0.1 for the Cabotage deployment; set it only to deploy somewhere else.
HOST=
# Honor X-Forwarded-Proto from the proxy in front of the app. Defaults to 1 when
# the app binds a loopback host, where only a local proxy can reach it. Without
# it, HTTPS requests look like http:// and fail origin checks.
VINEXT_TRUST_PROXY=
# Daily Clarity sync: on (default) or off. With it on, the production server
# syncs every Clarity connection that has daily sync enabled about once a day,
# and archives the previous month's chosen reports. Replicas share the work
# through the database. `make serve` and `make start` never run it.
CARBY_CLARITY_SCHEDULE=

# --- Tests -----------------------------------------------------------------
# Isolated PostgreSQL for the database-backed tests. There is deliberately no
# default: tests needing a database are skipped when this is unset. The helper
# creates a random schema, applies every postgres/*.sql migration into it, and
# drops it with CASCADE afterward. Point this at a separate, disposable
# PostgreSQL instance only -- not the local Compose database `make serve`
# provisions, and never a shared or remote database.
TEST_DATABASE_URL=
